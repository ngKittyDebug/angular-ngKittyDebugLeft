{
  "name": "ng-kitty-debug-left",
  "version": "0.0.0",
  "scripts": {
    "ci": "pnpm install --frozen-lockfile && pnpm prepare",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "test:cov": "ng test --coverage --watch=false --coverage-reporters json-summary --coverage-reporters text",
    "lint": "ng lint",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "dev": "concurrently -n ng,party -c blue,magenta \"pnpm start\" \"pnpm --filter @ng-kitty/partykit-server dev\"",
    "deploy:party": "pnpm --filter @ng-kitty/partykit-server run deploy",
    "test:party": "pnpm --filter @ng-kitty/partykit-server test",
    "preflight": "pnpm typecheck && pnpm lint && pnpm format && pnpm test",
    "skills:sync": "node scripts/sync-agent-skills.mjs",
    "skills:update": "npx -y skills@latest update -p -y && pnpm skills:sync",
    "prepare": "husky"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "validate-branch-name": {
    "pattern": "^(chore|feat|fix|docs|style|refactor|perf)\\/[a-zA-Z0-9-]+[_-][a-zA-Z0-9-]+$",
    "errorMsg": "Branch name is invalid."
  },
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-persist-lang": "^8.4.0",
    "@ngrx/signals": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "@taiga-ui/addon-charts": "^5.13.0",
    "@taiga-ui/addon-commerce": "^5.13.0",
    "@taiga-ui/addon-doc": "^5.13.0",
    "@taiga-ui/addon-mobile": "^5.13.0",
    "@taiga-ui/addon-table": "^5.13.0",
    "@taiga-ui/cdk": "^5.13.0",
    "@taiga-ui/core": "^5.13.0",
    "@taiga-ui/icons": "^5.13.0",
    "@taiga-ui/kit": "^5.13.0",
    "@taiga-ui/layout": "^5.13.0",
    "@taiga-ui/styles": "^5.13.0",
    "echarts": "^6.1.0",
    "ngx-echarts": "^22.0.0",
    "partysocket": "^1.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.4.0",
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.5",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-angular": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco-utils": "^8.4.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/coverage-v8": "^4.1.9",
    "angular-eslint": "21.4.0",
    "concurrently": "^9.2.3",
    "eslint": "^10.6.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "fast-check": "^4.8.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "less": "^4.6.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.62.1",
    "validate-branch-name": "^1.3.2",
    "vitest": "^4.1.9"
  }
}
