{
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["taiga-ui"],
  "prefersReducedMotion": false,
  "permissions": {
    "allow": [
      "Read(//tmp/**)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm prettier *)",
      "Bash(pnpm build *)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm format:fix)",
      "Bash(pnpm lint *)",
      "Bash(pnpm test *)",
      "Bash(pnpm ng *)",
      "Bash(pnpm dev *)",
      "Bash(pnpm preflight)",
      "Bash(pnpm --filter *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(npx ng *)",
      "Bash(npx prettier *)",
      "Bash(npx stylelint *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh api *)",
      "Bash(gh repo *)",
      "Bash(gh project *)",
      "Bash(gh label *)",
      "Bash(git remote *)",
      "Bash(git worktree *)",
      "Bash(git checkout *)",
      "Bash(git push *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' | { read -r f; [ -n \"$f\" ] && \"$CLAUDE_PROJECT_DIR/node_modules/.bin/prettier\" --write --ignore-unknown \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Prettier"
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  }
}
