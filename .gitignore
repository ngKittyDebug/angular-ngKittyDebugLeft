Thumbs.db

# --- Pokémon Feeding Frenzy / Claude sessions ---

# Local planning notes (per-developer, not for merge)
.planning/

# Local markdown issue tracker for agent skills (see docs/agents/issue-tracker.md)
.scratch/

# Per-developer agent-skills config (issue tracker, triage labels, domain docs)
docs/agents/

# Local domain glossary for grill-with-docs (per-developer, not for merge)
CONTEXT.md

# Local architecture decision records (per-developer, not for merge)
docs/adr/

# Claude Code — local config / sessions / skills stay local, EXCEPT the committed review
# skills (used by cloud routines, which only see what's in the repo), CLAUDE.md and .mcp.json
# (cloud routines need the taiga-ui / angular-cli verification MCPs too).
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/pr-review/
!.claude/skills/codebase-audit/
!.claude/skills/_shared/
skills-lock.json

.gemini

# PartyKit local dev state
.partykit/
partykit-server/.partykit/

# Cloudflare Wrangler local state (if/when partyserver path is used)
.wrangler/
partykit-server/.wrangler/

# Local env vars for PartyKit / Cloudflare
.dev.vars
partykit-server/.dev.vars

# Build / deploy artifacts of partykit-server
partykit-server/dist/
partykit-server/.partykit-deploy/
